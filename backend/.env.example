# Gemini API Key (Required for AI resume parsing & portfolio generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Secret key for JWT authentication
SECRET_KEY=your_jwt_secret_key_here

# Frontend origin for CORS (comma-separated if multiple)
FRONTEND_ORIGIN=http://localhost:5173

# SQLite database URL (defaults to sqlite:///./portfolio.db if omitted)
DATABASE_URL=sqlite:///./portfolio.db
